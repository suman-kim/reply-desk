# 운영체제
.DS_Store

# 의존성·빌드 결과
node_modules/
dist/
coverage/
*.tsbuildinfo

# 비밀 값 (예시는 server/env.example)
.env
.env.*

# 크롬 프로필·캡처 (로그인 정보가 들어 있다). 루트 기준으로만 뺀다:
# 그냥 profiles/라고 쓰면 server/src/profiles/(소스)까지 빠진다
/profiles/
/screenshots/
# PROFILES_ROOT를 상대 경로(yt-agent/profiles)로 두었을 때 생기는 프로필 폴더
yt-agent/

# 편집기 설정
.idea/
.vscode/
