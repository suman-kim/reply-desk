# reply-desk 서버 환경 변수 예시
# 실행 환경(NODE_ENV)에 맞는 파일로 복사해서 값을 채운다.
#   개발: cp env.example .env.development   (npm run start:dev, NODE_ENV 기본값 development)
#   운영: cp env.example .env.production    (npm run start:prod)
# NODE_ENV 파일을 먼저 읽고, 그 파일에 없는 값은 .env에서 읽는다.
# .env* 파일은 저장소에 올리지 않는다.

# API 서버 포트 (다른 프로젝트와 겹치지 않게 4100)
PORT=4100

# PostgreSQL 접속 정보 (docker-compose.yml과 같은 값)
DB_HOST=127.0.0.1
DB_PORT=5441
DB_USER=reply_desk
DB_PASSWORD=reply_desk
DB_NAME=reply_desk

# YouTube Data API v3 키 (영상 검색·조회수). 비워 두면 [영상 불러오기]가 원인과 함께 막힌다.
YOUTUBE_API_KEY=

# 크롬 프로필 폴더를 만들 상위 폴더. ~는 홈 폴더로 바뀐다.
PROFILES_ROOT=~/yt-agent/profiles

# 게시 실패 순간의 화면 캡처를 둘 폴더
SCREENSHOTS_DIR=~/yt-agent/screenshots

# AI 키. 어떤 AI를 쓸지는 DB 설정(/api/settings)에서 고르고, 키만 여기 둔다.
# Ollama는 키가 없고 주소를 설정에서 정한다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
