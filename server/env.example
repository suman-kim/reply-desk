# reply-desk 서버 환경 변수 예시
# 이 파일을 .env로 복사해서 값을 채운다: cp env.example .env
# .env는 저장소에 올리지 않는다.

# API 서버 포트 (다른 프로젝트와 겹치지 않게 4100)
PORT=4100

# PostgreSQL 접속 정보 (docker-compose.yml과 같은 값)
DB_HOST=127.0.0.1
DB_PORT=5441
DB_USER=reply_desk
DB_PASSWORD=reply_desk
DB_NAME=reply_desk

# YouTube Data API v3 키 (영상 검색·조회수). 비워 두면 [영상 불러오기]가 원인과 함께 막힌다.
YOUTUBE_API_KEY=

# 크롬 프로필 폴더를 만들 상위 폴더. ~는 홈 폴더로 바뀐다.
PROFILES_ROOT=~/yt-agent/profiles

# AI 키. 어떤 AI를 쓸지는 DB 설정(/api/settings)에서 고르고, 키만 여기 둔다.
# Ollama는 키가 없고 주소를 설정에서 정한다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
